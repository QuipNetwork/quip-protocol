#!/usr/bin/env bash
# Real-QPU shim for `quip-coordinator drive --miner <this>`. Loads D-Wave
# credentials from .env at runtime (never printed) and runs the real sampler
# (no mock). Use tools/drive/quip-dwave-qa for the offline mock path.
set -euo pipefail
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
export PYTHONPATH="$REPO/python${PYTHONPATH:+:$PYTHONPATH}"
# Load credentials (DWAVE_API_TOKEN etc.) without echoing them.
if [ -f "$REPO/.env" ]; then
  set -a
  . "$REPO/.env"
  set +a
fi
# Do NOT set QUIP_DWAVE_MOCK — connect to the real QPU.
exec "$REPO/.venv/bin/python" -m quip_miner_dwave "$@"
