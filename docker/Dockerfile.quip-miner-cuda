# quip-miner-cuda (v0.3) — coordinator + CPU + D-Wave + CUDA miners (amd64).
# Same builder as the CPU image; runtime is an NVIDIA CUDA base so the CUDA
# miner's NVRTC/driver calls resolve (cudarc dynamic-loads libcuda at runtime;
# run with `--gpus all`). CPU + CUDA miner binaries are downloaded from their
# releases; the coordinator is built from source; D-Wave is a Python venv.

# --- builder: quip-coordinator (Rust) + quip-dwave-qa venv (Python) ---
FROM python:3.12-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /src
COPY rust/ rust/
COPY proto/ proto/
RUN cargo build --release -p quip-coordinator --manifest-path rust/Cargo.toml

ARG MINERS_TAG=v0.3.0
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
       "quip-miner-dwave @ git+https://gitlab.com/quip.network/quip-miner-dwave.git@${MINERS_TAG}"

# --- runtime (NVIDIA CUDA + Python) ---
FROM nvidia/cuda:12.9.1-base-ubuntu24.04

LABEL org.opencontainers.image.source="https://gitlab.com/quip.network/quip-protocol"
LABEL description="quip-miner-cuda v0.3 — coordinator + CPU + D-Wave + CUDA"

ARG MINERS_TAG=v0.3.0
ARG QUIP_DOCKER_IMAGE=""
ENV QUIP_DOCKER_IMAGE=${QUIP_DOCKER_IMAGE} \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/venv/bin:/usr/local/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        tini gosu curl ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system --gid 1000 quip \
    && useradd --system --uid 1000 --gid 1000 --home /home/quip \
       --create-home --shell /usr/sbin/nologin quip

COPY --from=builder /src/rust/target/release/quip-coordinator /usr/local/bin/quip-coordinator
COPY --from=builder /opt/venv /opt/venv

# Released CPU + CUDA miner binaries (amd64 only for this image).
RUN cpu="https://gitlab.com/api/v4/projects/quip.network%2Fquip-miner-cpu/packages/generic/quip-miner-cpu/${MINERS_TAG}" \
    && cuda="https://gitlab.com/api/v4/projects/quip.network%2Fquip-miner-cuda/packages/generic/quip-miner-cuda/${MINERS_TAG}" \
    && for u in "${cpu}/quip-cpu-sa-amd64:quip-cpu-sa" "${cpu}/quip-cpu-gibbs-amd64:quip-cpu-gibbs" \
                "${cuda}/quip-cuda-sa-amd64:quip-cuda-sa" "${cuda}/quip-cuda-gibbs-amd64:quip-cuda-gibbs"; do \
         url="${u%%:*}"; name="${u##*:}"; \
         curl --fail --location --silent --show-error "$url" -o "/usr/local/bin/${name}" \
         && chmod +x "/usr/local/bin/${name}"; \
       done

WORKDIR /app
COPY docker/config.toml /app/config.toml
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
