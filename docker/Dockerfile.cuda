# Dockerfile for quip-miner — CUDA
# Substrate-attached miner using all available NVIDIA GPUs.
# Multi-stage build for smaller image size.

#############################################
# Stage 1: Build the wheel
#############################################
FROM python:3.13-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY shared/ ./shared/
COPY CPU/ ./CPU/
COPY GPU/ ./GPU/
COPY QPU/ ./QPU/
COPY dwave_topologies/ ./dwave_topologies/
COPY quip_cli.py ./

RUN pip install --no-cache-dir build && \
    python -m build --wheel --outdir /build/dist

#############################################
# Stage 2: Runtime image with CUDA
#############################################
FROM nvidia/cuda:12.9.1-base-ubuntu22.04

LABEL maintainer="Quip Protocol"
LABEL description="quip-miner — CUDA GPU"
LABEL org.opencontainers.image.source="https://gitlab.com/quip.network/quip-protocol"

# Image identity surfaced to telemetry — set by CI via
# `--build-arg QUIP_DOCKER_IMAGE=$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA`.
ARG QUIP_DOCKER_IMAGE=""
ENV QUIP_DOCKER_IMAGE=${QUIP_DOCKER_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Python + minimal CUDA libs for CuPy RawKernel + entrypoint deps
# (tini, gosu). Only cuda-cudart (runtime) and libnvrtc (kernel
# compilation) are needed — GPU code uses custom CUDA kernels via
# cp.RawModule, not cuBLAS/cuFFT/etc.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    tini gosu \
    cuda-cudart-12-9 \
    cuda-nvrtc-12-9 \
    && apt-get install -y --no-install-recommends cuda-mps-12-9 2>/dev/null || true \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/bin/python3 /usr/bin/python

# Non-root runtime user. USER stays root so entrypoint.sh can chown
# /data and keygen with the right ownership before dropping to quip.
RUN groupadd --system --gid 1000 quip \
    && useradd --system --uid 1000 --gid 1000 --home /home/quip \
       --create-home --shell /usr/sbin/nologin quip

WORKDIR /app

# Install the wheel with cuda extras
COPY --from=builder /build/dist/*.whl /tmp/
RUN WHEEL=$(ls /tmp/*.whl) && \
    pip install --no-cache-dir "${WHEEL}[cuda]" && \
    rm /tmp/*.whl

ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}

# Config template + entrypoint
COPY docker/quip-miner.cuda.toml /app/quip-miner.docker.toml
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Image baseline: gpu mode. Operators override on `docker run -e ...`.
ENV QUIP_MODE=gpu
ENV QUIP_MINE_MODE=pow

# Persistent /data: holds config.toml + keystore.json across restarts.
VOLUME ["/data"]

# Telemetry REST API (off by default; expose via -p when enabled).
EXPOSE 8086/tcp

ENTRYPOINT ["tini", "--", "/entrypoint.sh"]
