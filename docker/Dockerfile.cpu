# Dockerfile for quip-miner — CPU
# Substrate-attached miner using all available CPUs for SA mining.
# Multi-stage build for smaller image size.

#############################################
# Stage 1: Build the wheel
#############################################
FROM python:3.13-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md LICENSE ./
COPY shared/ ./shared/
COPY substrate/ ./substrate/
COPY CPU/ ./CPU/
COPY GPU/ ./GPU/
COPY QPU/ ./QPU/
COPY dwave_topologies/ ./dwave_topologies/
COPY quip_cli.py ./

RUN pip install --no-cache-dir build && \
    python -m build --wheel --outdir /build/dist

#############################################
# Stage 2: Runtime image
#############################################
FROM python:3.13-slim-bookworm

LABEL maintainer="Quip Protocol"
LABEL description="quip-miner — CPU"
LABEL org.opencontainers.image.source="https://gitlab.com/quip.network/quip-protocol"

# Image identity surfaced to telemetry — set by CI via
# `--build-arg QUIP_DOCKER_IMAGE=$CI_REGISTRY_IMAGE:$CI_COMMIT_SHORT_SHA`.
ARG QUIP_DOCKER_IMAGE=""
ENV QUIP_DOCKER_IMAGE=${QUIP_DOCKER_IMAGE}

# Runtime deps: tini for PID 1, gosu for the entrypoint's privilege
# drop. build-essential is retained for arch builds where PyPI wheels
# may be missing for a base dep and pip falls back to source.
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini gosu build-essential \
    && rm -rf /var/lib/apt/lists/*

# Non-root runtime user. USER stays root so entrypoint.sh can chown
# /data and keygen with the right ownership before dropping to quip.
RUN groupadd --system --gid 1000 quip \
    && useradd --system --uid 1000 --gid 1000 --home /home/quip \
       --create-home --shell /usr/sbin/nologin quip

WORKDIR /app

# Install the wheel with cpu extras
COPY --from=builder /build/dist/*.whl /tmp/
RUN WHEEL=$(ls /tmp/*.whl) && \
    pip install --no-cache-dir "${WHEEL}[cpu]" && \
    rm /tmp/*.whl

# Config template + entrypoint
COPY docker/quip-miner.cpu.toml /app/quip-miner.docker.toml
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Image baseline: cpu mode. Operators override on `docker run -e ...`.
ENV QUIP_MODE=cpu
ENV QUIP_MINE_MODE=pow

# Persistent /data: holds config.toml + keystore.json across restarts.
VOLUME ["/data"]

# Telemetry REST API (off by default; expose via -p when enabled).
EXPOSE 8086/tcp

ENTRYPOINT ["tini", "--", "/entrypoint.sh"]
